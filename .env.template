DHIS2_BASE_URL=http://localhost:8080/dhis

# Authentication — use one of the two options below:

# Option 1: Personal Access Token (recommended for DHIS2 2.38+)
# Create one in DHIS2 under: Profile → Edit profile → Personal access tokens
DHIS2_API_TOKEN=

# Option 2: Username and password (Basic Auth)
DHIS2_USERNAME=admin
DHIS2_PASSWORD=district

# Optional: dev-server port (default 8081)
# DHIS2_DEV_PORT=8082
